#!/bin/bash
# Startup gate for uat-stats: block until BOTH of dump978's outputs -- decoded
# JSON (:30979) and raw (:30978) -- accept a TCP connection, so stats.py (which
# opens a socket to each) doesn't race dump978 at boot and log "connection
# refused" retries. Probing only :30979 still let stats.py's raw-socket thread
# lose the race, since :30978 can bind a moment later. Mirrors wait-for-readsb
# (bash /dev/tcp: connect then close, without draining the stream).
#
# Gated on local 978 decode: in remote mode / with UAT off, dump978 never binds
# :30979, so skip immediately -- otherwise we'd add a pointless ~30s boot delay on
# every non-UAT boot. Fail OPEN after ~30s so a dump978 problem can't wedge
# uat-stats behind this gate (and stats.py retries internally regardless).
if [ "${ENABLE_UAT:-false}" != "true" ] || [ "${RECEIVER_MODE:-rtlsdr}" = "remote" ]; then
  echo "[wait-for-dump978] UAT decode off (enable_uat off or remote mode); nothing to wait for"
  exit 0
fi
tries=0
while [ "${tries}" -lt 60 ]; do
  if (exec 3<>/dev/tcp/127.0.0.1/30978) 2>/dev/null && (exec 3<>/dev/tcp/127.0.0.1/30979) 2>/dev/null; then
    echo "[wait-for-dump978] dump978 :30978 and :30979 are up; releasing uat-stats"
    exit 0
  fi
  tries=$((tries + 1))
  sleep 0.5
done
echo "[wait-for-dump978] dump978 :30978/:30979 not both accepting after 30s -- releasing uat-stats anyway"
exit 0
